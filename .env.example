# ---------------------------------------------------------------------------
# CockroachDB — choose ONE of the two blocks below.
# ---------------------------------------------------------------------------

# (a) Component form — what CockroachDB Cloud gives you in the console.
#     The password is URL-encoded for you; do not pre-encode it here.
CLUSTER_NAME=whole-bee-31805
CLUSTER_USER=your-sql-user
CLUSTER_PASSWORD=your-sql-password
CRDB_HOST=whole-bee-31805.j77.aws-eu-west-2.cockroachlabs.cloud
CRDB_PORT=26257
CRDB_DATABASE=defaultdb
CRDB_SSLMODE=verify-full
# Optional. Auto-discovered at ~/.postgresql/root.crt or ./certs/root.crt if omitted.
# CRDB_SSLROOTCERT=./certs/root.crt
CRDB_CLUSTER_ID=783529e4-168f-4c42-b447-38d4885b1d80

# (b) Full DSN form — overrides the component form when set to a non-local host.
# FLEETMEM_DSN=postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full

# Local Docker fallback, used when neither of the above is provided:
#   postgresql://root@localhost:26257/fleet?sslmode=disable

# ---------------------------------------------------------------------------
# AWS — optional. Without credentials the app runs on local fallbacks and says so.
# ---------------------------------------------------------------------------
AWS_REGION=us-west-2
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
FLEETMEM_S3_BUCKET=

# Set to 1 to hard-fail instead of degrading to local fallbacks (CI / production).
FLEETMEM_STRICT=0
